# Server Configuration
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nodejs_crud_prod
DB_USER=postgres
DB_PASSWORD=your-production-password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-must-be-changed
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-must-be-changed
JWT_REFRESH_EXPIRES_IN=30d

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
