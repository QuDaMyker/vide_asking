# Environment Configuration
NODE_ENV=staging
PORT=3000

# Database Configuration
DB_HOST=staging-db.example.com
DB_PORT=5432
DB_NAME=nodejs_template_staging
DB_USER=staging_user
DB_PASSWORD=your_staging_password_here

# JWT Configuration
JWT_SECRET=your_staging_jwt_secret_change_this
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=your_staging_refresh_secret_change_this
JWT_REFRESH_EXPIRES_IN=3d

# CORS Configuration
CORS_ORIGIN=https://staging.example.com

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
