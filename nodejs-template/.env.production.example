# Environment Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_NAME=nodejs_template_prod
DB_USER=prod_user
DB_PASSWORD=your_production_password_here

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_change_this
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_production_refresh_secret_change_this
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=https://api.example.com,https://example.com

# Logging
LOG_LEVEL=error

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
HELMET_ENABLED=true
TRUST_PROXY=true
